{
  "name": "@iap/core",
  "private": true,
  "version": "0.1.0",
  "description": "Insurance Domain Core + BFF (NestJS modular monolith)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:int": "jest --config jest.int.config.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "ts-node src/kernel/db/migrate.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.8",
    "typescript-eslint": "^8.71.0"
  }
}
