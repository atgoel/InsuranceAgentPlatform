# Phone access over HTTPS. Set only IAP_PHONE_HOST (the PC's LAN IP or hostname); everything else derives from it.
#   IAP_PHONE_HOST=192.168.1.20 docker compose -f infra/dev/docker-compose.yml --env-file infra/dev/phone.env \
#     --profile app --profile phone up -d --build
IAP_KC_URL=https://${IAP_PHONE_HOST}:8443
IAP_DEV_TENANTS={"localhost":{"tenantId":"ten_acme","status":"active"},"${IAP_PHONE_HOST}":{"tenantId":"ten_acme","status":"active"}}
KC_PROXY_HEADERS=xforwarded
