# Second, isolated stack next to the default one (docs/dev/isolated-stack.md). Copy to stack2.env and adjust.
#   docker compose -p iap2 -f infra/dev/docker-compose.yml --env-file infra/dev/stack2.env --profile app --profile origin up -d --no-build
# Every port and name differs from the default stack, so both can run at once.
IAP_STACK=iap2
IAP_PORT_POSTGRES=15433
IAP_PORT_KEYCLOAK=18180
IAP_PORT_CORE=13000
IAP_PORT_WEB=9080
IAP_PORT_PROTOTYPE=9081
IAP_KC_URL=http://localhost:18180
